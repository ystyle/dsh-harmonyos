{
  "name": "dsh-harmonyos",
  "version": "0.10.1",
  "description": "DeepSeek Harness for HarmonyOS — 一条命令装好:JS-only 替代/裁剪 profile、鸿蒙文件系统补丁、compat loader(zstd/fs-ext/sharp shim)、自启脚本(优先原生 zstd 的 node)。装完跑 dsh-ohos 即可。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harmonyos",
    "ohos",
    "agent"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-ohos": "./bin/dsh-ohos.js",
    "dsh-harmonyos": "./bin/dsh-ohos.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./compat-loader": "./compat/compat-loader.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "node ./lib/patch.mjs patch && node ./lib/prune.mjs",
    "patch": "node ./lib/patch.mjs patch",
    "check": "node ./lib/patch.mjs check",
    "preflight": "node ./lib/anchors.mjs",
    "prune": "node ./lib/prune.mjs",
    "sync-forks": "node ./scripts/sync-forks.mjs",
    "cutover": "node ./scripts/cutover-overrides.mjs",
    "test": "node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-auto": "^0.1.5-rc.2",
    "zstd-codec": "^0.1.5",
    "@img/sharp-wasm32": "0.35.4",
    "@deepseek-ai/dsh-session-persistence-jsonl": "npm:@dsh-harmonyos/dsh-session-persistence-jsonl@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/dsh-attachment-local": "npm:@dsh-harmonyos/dsh-attachment-local@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/dsh-fs-local": "npm:@dsh-harmonyos/dsh-fs-local@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/node-addon-system": "npm:@dsh-harmonyos/node-addon-system@0.1.2-harmony.1",
    "@deepseek-ai/dsh-client-resources": "npm:@dsh-harmonyos/dsh-client-resources@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/dsh-tool-fs-search": "npm:@dsh-harmonyos/dsh-tool-fs-search@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/dsh-credentials-local": "npm:@dsh-harmonyos/dsh-credentials-local@0.1.5-rc.2-harmony.1",
    "@deepseek-ai/dsh-sandbox-policy": "npm:@dsh-harmonyos/dsh-sandbox-policy@0.1.5-rc.2-harmony.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ystyle/dsh-harmonyos.git"
  },
  "homepage": "https://github.com/ystyle/dsh-harmonyos#readme",
  "bugs": {
    "url": "https://github.com/ystyle/dsh-harmonyos/issues"
  }
}
